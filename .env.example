# --- copy to .env and change every secret ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
CORS_ALLOWED_ORIGINS=http://localhost,http://192.168.1.10
POSTGRES_DB=goldshop
POSTGRES_USER=goldshop
POSTGRES_PASSWORD=change-me
# First start only: creates the owner account if it does not exist yet
OWNER_USERNAME=owner
OWNER_PASSWORD=
WEB_PORT=80
API_PORT=8000
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

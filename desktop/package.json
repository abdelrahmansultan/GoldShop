{
  "name": "goldshop-desktop",
  "productName": "Gold Shop ERP",
  "version": "1.0.0",
  "description": "Gold & Jewelry Shop ERP — Windows desktop client",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "build:web": "npm --prefix ../frontend run build && node scripts/copy-web.cjs",
    "start": "electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.goldshop.erp",
    "productName": "Gold Shop ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Gold Shop ERP"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
